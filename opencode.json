{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 3,
  "mcp": {
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "codegraph": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@colbymchenry/codegraph@1.5.0", "serve", "--mcp"]
    },
    "headroom": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "--from", "headroom-ai[mcp]", "headroom", "mcp", "serve"]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "lfx-research": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "--with", "mcp[cli]", "--with", "lfx", "--with", "python-dotenv", "--from", ".opencode/mcp/lfx-research", "lfx-research-mcp"],
      "environment": {
        "KNOWLEDGE_LIBRARY_HOME": ".opencode/knowledge-library",
        "LFX_FLOW_PATH": ".opencode/mcp/lfx-research/flows/investigacion-conocimiento.json"
      }
    }
  }
}
