# lfx-research MCP — environment template
# Copy to .env and fill your values. Never commit .env (gitignored).
# Priority: .env > opencode.json env > host env

# --- OpenAI-compatible API (used by Refiner and Langflow/LFX workflow) ---
# Any OpenAI-compatible provider works (OpenAI, OpenRouter, local Ollama, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- LFX workflow models ---
# Models used inside the Langflow flow (researcher / auditor nodes)
LFX_RESEARCH_MODEL=gpt-4o-mini
LFX_AUDITOR_MODEL=gpt-4o

# --- Paths ---
# Langflow flow executed via `lfx run`. Relative to repo root.
LFX_FLOW_PATH=.opencode/mcp/lfx-research/flows/investigacion-conocimiento.json
# Isolated library — do NOT point to ~/biblioteca-conocimientos
KNOWLEDGE_LIBRARY_HOME=.opencode/knowledge-library

# --- Optional n8n bridge (backward compat, disabled by default) ---
LFX_ENABLE_N8N_BRIDGE=false
N8N_KNOWLEDGE_WEBHOOK_URL=http://localhost:5678/webhook/investigar-conocimiento

# --- Runtime flags ---
# Stateless run (no langflow.db)
LFX_STATELESS=true
# Log level for the MCP server
LFX_LOG_LEVEL=info
