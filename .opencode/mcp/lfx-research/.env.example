# lfx-research MCP — environment template
# Copy to .env and fill your values. Never commit .env (gitignored).
# Priority: .env > opencode.json env > host env
# All LLM access is via OpenAI-compatible API — just set base_url + api_key + model.

# ==============================================================================
# LLM PROVIDER — OpenAI-compatible (any provider that speaks OpenAI API)
# ==============================================================================
# This MCP and Langflow's "OpenAI Compatible" provider use the same 3 vars.
# Langflow flow nodes (Language Model / Agent) read them as {{env.OPENAI_*}}.
# Refiner / LFX flow also reads them here, so one config covers everything.

# API key for the provider (sk-...). Leave empty for local Ollama/LMStudio.
OPENAI_API_KEY=sk-...

# Base URL of the OpenAI-compatible endpoint. Must end with /v1
# Common examples — uncomment one and adjust:
OPENAI_BASE_URL=https://api.openai.com/v1              # OpenAI
# OPENAI_BASE_URL=https://openrouter.ai/api/v1          # OpenRouter (Claude/GPT/Gemini via one key)
# OPENAI_BASE_URL=https://api.together.xyz/v1            # Together AI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1         # Groq (fast)
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1  # Fireworks
# OPENAI_BASE_URL=https://api.perplexity.ai               # Perplexity (omit /v1)
# OPENAI_BASE_URL=https://api.deepseek.com                # DeepSeek direct (OpenAI-compatible, models: deepseek-chat, deepseek-reasoner, deepseek-coder)

# --- OpenCode Zen / Go (OpenAI-compatible subscription APIs) ---
# Zen pay-as-you-go, Go flat $10/mo — both are OpenAI-compatible. Get key at https://opencode.ai/zen
# Endpoint is always base_url + /chat/completions — model is sent in JSON body.
# OPENAI_BASE_URL=https://opencode.ai/zen/v1             # Zen
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1          # Go
# For Zen/Go, model is an OpenCode model id (e.g. deepseek-v4-flash, qwen3.6-plus, gpt-5.2) or a routed OpenAI name.
# See available models: GET https://opencode.ai/zen/v1/models and /zen/go/v1/models

# --- Local / self-hosted (no key needed) ---
# OPENAI_BASE_URL=http://localhost:11434/v1              # Ollama (ollama serve, model e.g. llama3, gpt-oss-20b)
# OPENAI_BASE_URL=http://localhost:1234/v1               # LMStudio
# OPENAI_BASE_URL=http://localhost:8000/v1               # vLLM / TGI / custom

# Model id to use via the base_url above. Must exist on that provider.
# For Zen/Go use OpenCode model ids; for OpenRouter use openai/gpt-4o, anthropic/claude-3.5-sonnet, etc.
OPENAI_MODEL=gpt-4o-mini

# --- LFX workflow models (inherit OPENAI_MODEL if empty) ---
# Models used inside the Langflow flow (researcher / auditor nodes). Can be same or different providers
# if you use an OpenAI-compatible gateway that routes both. Keep simple: same provider, two model ids.
LFX_RESEARCH_MODEL=gpt-4o-mini
LFX_AUDITOR_MODEL=gpt-4o

# Claude / Anthropic note:
# - For Claude via OpenAI-compatible: use OpenRouter, Together, or OpenCode proxy with anthropic/claude-3.5-sonnet.
#   Example: OPENAI_BASE_URL=https://openrouter.ai/api/v1 + OPENAI_MODEL=anthropic/claude-3-5-sonnet
# - Claude direct (Anthropic) is NOT OpenAI-compatible: uses https://api.anthropic.com + header x-api-key + model claude-3-5-sonnet.
#   It requires Langflow native "Anthropic" bundle, NOT this OPENAI_* env. Keep our flow on OpenAI Compatible for simplicity.
# - Langflow also has native Anthropic/Claude bundle components (separate from OpenAI Compatible).
#   If you need native Anthropic, set provider to Anthropic in Langflow UI instead of this .env.
# - For our MCP we keep OpenAI Compatible as the single standard — add native provider only if you need it.
# - DeepSeek direct is OpenAI-compatible: same 3 vars work (base_url https://api.deepseek.com, model deepseek-chat).

# ==============================================================================
# PATHS
# ==============================================================================
# Langflow flow executed via `lfx run`. Relative to repo root.
LFX_FLOW_PATH=.opencode/mcp/lfx-research/flows/investigacion-conocimiento.json
# Isolated library — do NOT point to ~/biblioteca-conocimientos unless you want legacy
KNOWLEDGE_LIBRARY_HOME=.opencode/knowledge-library

# ==============================================================================
# OPTIONAL — n8n bridge (backward compat, disabled by default)
# ==============================================================================
LFX_ENABLE_N8N_BRIDGE=false
N8N_KNOWLEDGE_WEBHOOK_URL=http://localhost:5678/webhook/investigar-conocimiento

# ==============================================================================
# RUNTIME FLAGS
# ==============================================================================
LFX_STATELESS=true
LFX_LOG_LEVEL=info
